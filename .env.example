# Optional REST endpoint that receives every captured message as JSON.
# Leave blank to store to SQLite only.
WEBHOOK_URL=
WEBHOOK_TOKEN=

# Local read API port
PORT=3000

# Where messages are stored
DB_PATH=./data/messages.db

# Folder holding the WhatsApp pairing credentials
WA_AUTH_DIR=./.wa-auth

# Capture group chats only (set to false to include DMs)
GROUPS_ONLY=true

# Capture messages sent by the agent's own account
CAPTURE_OWN=false
